# Habitat API (ends in /api/v1). The demo form posts here, and the API must allow this site's origin in CORS.
VITE_API_URL=https://api.habitat-api.com/api/v1
# Where the "Get started" / "Sign in" buttons go (the Habitat owner console).
VITE_PORTAL_URL=
# A live guest booking site to show as an example ("See a hotel's booking site").
VITE_GUEST_DEMO_URL=https://app.habitat-api.com
# Optional: a sales email and phone shown next to the demo form.
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
